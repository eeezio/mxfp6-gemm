+// ---- Track 4: B-through-LDS path tests ----
+// Setup for the bLDS kernel: uses compact B^T (preprocess_B output, not preshuffled).
+// Both A and B are staged through LDS double-buffers in the kernel.
+struct DevBlds {
+    void *dA, *dBc;             // dBc = compact B^T device buffer
+    uint8_t *dsA, *dsB;
+    int Ar, Bc_row;             // A_row_bytes, B_compact_row_bytes (= Bq.packed_row_bytes)
+    int Kp;
+    QuantizedMatrix Aq, Bq;
+};
+static DevBlds setup_blds(int M, int N, int K, TileChoice tc) {
+    int Kp = ((K + KT - 1) / KT) * KT;
+    std::mt19937 rng(M * 3 + N * 7 + K + 42);
+    std::uniform_real_distribution<float> d(-1, 1);
+    std::vector<float> Af((size_t)M * Kp, 0.f), Bf((size_t)Kp * N, 0.f);
+    for (int i = 0; i < M; i++)
+        for (int k = 0; k < K; k++) Af[(size_t)i * Kp + k] = d(rng);
+    for (int k = 0; k < K; k++)
+        for (int j = 0; j < N; j++) Bf[(size_t)k * N + j] = d(rng);
+    DevBlds x;
+    x.Aq = quantize_to_mxfp6(Af.data(), M, Kp);
+    x.Bq = preprocess_B(Bf.data(), Kp, N);  // compact B^T [N][Kp], packed FP6
+    // Scales: same tiled-scale layout as original kernel (MPW for A, NPW for B).
+    auto saC = tile_scale(preprocess_scale(x.Aq.scales.data(), M, Kp), tc.MPW, KT / 64);
+    auto sbC = tile_scale(preprocess_scale(x.Bq.scales.data(), N, Kp), tc.NPW, KT / 64);
+    hipMalloc(&x.dA, x.Aq.packed_data.size());
+    // Upload compact B^T (not preshuffled)
+    hipMalloc(&x.dBc, x.Bq.packed_data.size());
+    hipMalloc(&x.dsA, saC.data.size());
+    hipMalloc(&x.dsB, sbC.data.size());
+    hipMemcpy(x.dA, x.Aq.packed_data.data(), x.Aq.packed_data.size(), hipMemcpyHostToDevice);
+    hipMemcpy(x.dBc, x.Bq.packed_data.data(), x.Bq.packed_data.size(), hipMemcpyHostToDevice);
+    hipMemcpy(x.dsA, saC.data.data(), saC.data.size(), hipMemcpyHostToDevice);
+    hipMemcpy(x.dsB, sbC.data.data(), sbC.data.size(), hipMemcpyHostToDevice);
+    x.Ar = x.Aq.packed_row_bytes;
+    x.Bc_row = x.Bq.packed_row_bytes;  // fp6_packed_bytes(Kp)
+    x.Kp = Kp;
+    return x;
+}
+static void teardown_blds(DevBlds& x) {
+    hipFree(x.dA);
+    hipFree(x.dBc);
+    hipFree(x.dsA);
+    hipFree(x.dsB);
+}
+
+// Verify the B-through-LDS path against CPU reference.
+static bool verify_blds(int M, int N, int K) {
+    TileChoice tc = choose_tile(M, N);
+    if (!detail::use_blds_path(M, N, ((K + KT - 1) / KT) * KT)) {
+        printf("  bLDS %4dx%4dx%4d -> SKIP (not in bLDS regime)\n", M, N, K);
+        return true;
+    }
+    DevBlds x = setup_blds(M, N, K, tc);
+    std::vector<float> Dref((size_t)M * N);
+    mxfp6_gemm_ref(x.Aq, x.Bq, Dref.data(), M, x.Kp, N);
+    float* dD;
+    hipMalloc(&dD, (size_t)M * N * 4);
+    hipMemset(dD, 0x5A, (size_t)M * N * 4);
+    detail::dispatch_gemm_blds(M, N, x.Kp, x.dA, x.dBc, x.dsA, x.dsB, dD,
+                               x.Ar, x.Bc_row);
+    hipDeviceSynchronize();
+    std::vector<float> Dg((size_t)M * N);
+    hipMemcpy(Dg.data(), dD, (size_t)M * N * 4, hipMemcpyDeviceToHost);
+    hipFree(dD);
+    float er = 0, mx = 0;
+    size_t nans = 0;
+    for (size_t i = 0; i < (size_t)M * N; i++) {
+        if (std::isnan(Dg[i])) nans++;
+        er = fmaxf(er, fabsf(Dg[i] - Dref[i]));
+        mx = fmaxf(mx, fabsf(Dref[i]));
+    }
+    bool ok = nans == 0 && er < 2e-2f * fmaxf(1.f, mx);
+    printf("  bLDS %4dx%4dx%4d -> %dx%d : NaNs=%zu er=%.4f %s\n",
+           M, N, K, tc.MT, tc.NT, nans, er, ok ? "OK" : "FAIL<<<");
+    teardown_blds(x);
+    return ok;
+}
+
+// Perf benchmark for the B-through-LDS path (FP16 out).
+static void perf_blds(int M, int N, int K) {
+    TileChoice tc = choose_tile(M, N);
+    int Kp = ((K + KT - 1) / KT) * KT;
+    if (!detail::use_blds_path(M, N, Kp)) {
+        printf("  bLDS %5dx%5dx%5d -> SKIP\n", M, N, K);
+        return;
+    }
+    DevBlds x = setup_blds(M, N, K, tc);
+    __half* dD;
+    hipMalloc(&dD, (size_t)M * N * 2);
+    auto run = [&] {
+        detail::dispatch_gemm_blds(M, N, x.Kp, x.dA, x.dBc, x.dsA, x.dsB, dD,
+                                   x.Ar, x.Bc_row);
+    };
+    double ms = bench(run);
+    int base_wg = (M / tc.MT) * (N / 256);
+    printf("  bLDS %5dx%5dx%5d wg=%4d -> %3dx%3d : %.0f TFLOPs\n",
+           M, N, K, base_wg, tc.MT, tc.NT, tf(M, N, K, ms));
+    hipFree(dD);
+    teardown_blds(x);
+}
