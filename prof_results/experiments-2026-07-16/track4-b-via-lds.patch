+// dispatch_gemm_blds: B-through-LDS path for large-K/wide-N 128x256-tile shapes.
+// Requires: compact B^T [N_col][K_byte] buffer (NOT preshuffled), B_compact_row_bytes = Bq.packed_row_bytes.
+// Guard: Kp > 50000 && 128x256 tile is selected && N % 256 == 0.
+// Scales (dsA, dsB) are the same tiled-scale buffers as the original kernel.
+// Does NOT support split-K (those shapes have small Kp, orthogonal regime).
+template <typename OutT>
+inline void dispatch_gemm_blds(int M, int N, int Kp, const void* dA, const void* dBc,
+                               const uint8_t* dsA, const uint8_t* dsB, OutT* dD,
+                               int A_row_bytes, int B_compact_row_bytes) {
+    constexpr int KT = K_TILE;
+    dim3 blk(256);
+    int kit = Kp / 64;
+    // 128x256 tile: 2 waves_M x 2 waves_N = 4 waves / WG
+    dim3 g(M / 128, N / 256);
+    // LDS: 2*A_BYTES + 2*B_BYTES = 2*(128*KT_BYTES) + 2*(256*KT_BYTES) = 110592 bytes
+    constexpr int KT_BYTES = KT * 6 / 8;
+    int lds = 2 * (128 * KT_BYTES) + 2 * (256 * KT_BYTES);
+    lds_gemm_bLDS<128, 256, KT, 2, 2, 1, OutT>
+        <<<g, blk, lds>>>(dA, dBc, dsA, dsB, dD, N, kit, A_row_bytes, B_compact_row_bytes);
+}
+
+// Returns true if the B-through-LDS path should be used for this shape.
+inline bool use_blds_path(int M, int N, int Kp) {
+    TileChoice tc = choose_tile(M, N);
+    return (Kp > 50000) && (tc.MT == 128) && (N % 256 == 0);
+}
+
 }  // namespace detail
 }  // namespace mxfp6
